{
  "App": {
    "SelfUrl": "https://localhost:44343",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=KargoApp;User ID=kargo;Password=<appsettings.secrets.json>;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44343",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "KargoApp_Swagger",
    "CertificatePassPhrase": "ad5378c3-590c-4328-8d8a-24cac279f61e"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "9WPqsrk0CLqFR6WI"
  }}