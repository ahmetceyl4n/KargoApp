{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=KargoApp;User ID=kargo;Password=<appsettings.secrets.json>;"
  },
  "RabbitMQ": {
    "Connections": {
      "Default": {
        "HostName": "localhost",
        "Port": 5672,
        "UserName": "kargo",
        "Password": "<appsettings.secrets.json>"
      }
    },
    "EventBus": {
      "ClientName": "KargoApp.Worker",
      "ExchangeName": "KargoApp"
    }
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "ScanProcessing": {
    "Lanes": 4,
    "ShipmentsPerBatch": 50,
    "IdleDelayMs": 1000,
    "MaxAttempts": 5,
    "RetryDelayMs": 2000
  }
}
